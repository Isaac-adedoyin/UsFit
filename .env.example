PORT=3000
SESSION_SECRET=some-long-random-string-for-session-encryption

# Set a long shared passphrase to protect both approved accounts.
USFIT_PASSPHRASE=
# Optional absolute directory for persistent local storage
# USFIT_DATA_DIR=/path/to/usfit-data

# Shared timezone for exact workout dates
USFIT_TIMEZONE=Europe/Budapest

# AI Fitness Coach API Key (Groq / Gemini)
GROQ_API_KEY=gsk_your_groq_api_key_here
